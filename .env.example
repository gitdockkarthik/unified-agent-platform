# ══════════════════════════════════════════════════════════════════════════════
#  Unified Agent Platform — environment variables
#
#  Copy to .env and fill in real values before running `make dev`.
#  Never commit .env.
#
#  Phase 3 migration path per variable is noted inline:
#    Railway dashboard env  →  k8s Secret  (namespace: platform)
# ══════════════════════════════════════════════════════════════════════════════


# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by: postgres service (runtime), backend (DATABASE_URL built from these)
# Phase 3 → k8s Secret platform/postgres-credentials

POSTGRES_USER=uap
POSTGRES_PASSWORD=changeme                      # Phase 3 → k8s Secret platform/postgres-credentials
POSTGRES_DB=uap_db


# ─── Backend ──────────────────────────────────────────────────────────────────
# Used by: backend service only
# DATABASE_URL is constructed automatically by docker-compose from POSTGRES_* vars above.
# Set manually only when connecting to an external DB (e.g., Railway Postgres add-on).
# Phase 3 → k8s Secret platform/backend-secrets

DATABASE_URL=postgresql+asyncpg://uap:changeme@localhost:5432/uap_db   # Phase 3 → k8s Secret platform/backend-secrets
SECRET_KEY=changeme-replace-with-64-char-hex-string                     # Phase 3 → k8s Secret platform/backend-secrets
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"

BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000              # Phase 3 → k8s ConfigMap platform/backend-config


# ─── Anthropic (backend only) ─────────────────────────────────────────────────
# The backend holds the single Anthropic key and forwards it to agents via the
# X-Anthropic-Key HTTP header at invoke time. Agents have no direct access.
# Phase 3 → k8s Secret platform/anthropic-credentials

ANTHROPIC_API_KEY=sk-ant-api03-...             # Phase 3 → k8s Secret platform/anthropic-credentials


# ─── API key (backend ↔ portal ↔ CI) ──────────────────────────────────────────
# Shared secret sent as X-API-Key by all callers of the backend registry and
# orchestration APIs (portal, make register, make test, CI pipelines).
# Phase 3 → k8s Secret platform/backend-secrets

BACKEND_API_KEY=changeme-replace-with-long-random-string  # Phase 3 → k8s Secret platform/backend-secrets


# ─── Shared model config ──────────────────────────────────────────────────────
# Applied to both agents. Override per-agent by setting their own MODEL in
# docker-compose environment block.
# Phase 3 → k8s ConfigMap platform/agent-config

MODEL=claude-sonnet-4-6                        # Phase 3 → k8s ConfigMap platform/agent-config


# ─── Agent: Alert Analyser ───────────────────────────────────────────────────
# Used by: alert-analyser service only. No ANTHROPIC_API_KEY — injected at runtime.
# Phase 3 → k8s ConfigMap platform/agent-config (non-secret vars)

ALERT_ANALYSER_PORT=8001
ALERT_ANALYSER_AGENT_ID=                       # UUID assigned after first `make register`
NOISE_THRESHOLD_REPEAT=3                       # Phase 3 → k8s ConfigMap platform/alert-analyser-config
NOISE_THRESHOLD_CLOSE_SECS=300                 # Phase 3 → k8s ConfigMap platform/alert-analyser-config


# ─── Agent: CUR Analyser ─────────────────────────────────────────────────────
# Used by: cur-analyser service only. No ANTHROPIC_API_KEY — injected at runtime.
# Phase 3 → k8s ConfigMap platform/agent-config (non-secret vars)

CUR_ANALYSER_PORT=8002
CUR_ANALYSER_AGENT_ID=                         # UUID assigned after first `make register`


# ─── Portal ───────────────────────────────────────────────────────────────────
# Portal JS only knows BACKEND_URL. No DB, no Anthropic key, no agent URLs.
# Phase 3 → k8s ConfigMap platform/portal-config

PORTAL_PORT=3000
# BACKEND_URL is set to http://backend:8000 automatically by docker-compose.
# Override here only when the backend is hosted externally (e.g., Railway public URL).
BACKEND_URL=http://localhost:8000              # Phase 3 → k8s ConfigMap platform/portal-config
